# Owner/admin connection: runs migrations and creates tenants.
ADMIN_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rag
# The API connects as the low-privilege rag_app role, so row-level security is always enforced.
# Change the password in production: ALTER ROLE rag_app PASSWORD '...';
APP_DATABASE_URL=postgresql://rag_app:rag_app@localhost:5432/rag
ADMIN_TOKEN=change-me
# Without a key the API runs fully offline (hashing embeddings + extractive answers) for demos.
OPENAI_API_KEY=
EMBED_DIM=1536
